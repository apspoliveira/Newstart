    <!-- Dicas - Nutrição -->
    <string name="hint_nutr_1">Consuma uma variedade de frutas e vegetais coloridos todos os dias.</string>
    <string name="hint_nutr_2">Escolha cereais integrais em vez de refinados para melhor ingestão de fibras.</string>
    <string name="hint_nutr_3">Proteínas vegetais como lentilhas e feijões são ótimas para o coração.</string>
    <string name="hint_nutr_4">Limite alimentos processados e açúcares adicionados na sua dieta.</string>
    <string name="hint_nutr_5">Mastigue bem os alimentos para ajudar na digestão e absorção.</string>
    <string name="hint_nutr_6">Um pequeno-almoço saudável fornece energia e estabiliza o açúcar.</string>

    <!-- Dicas - Sol -->
    <string name="hint_sun_1">A luz solar é a melhor fonte natural de Vitamina D.</string>
    <string name="hint_sun_2">15-20 minutos de exposição solar diária são ideais.</string>
    <string name="hint_sun_3">A luz do sol ajuda a regular o seu sono e o ritmo circadiano.</string>
    <string name="hint_sun_4">A exposição solar melhora o humor através da serotonina.</string>
    <string name="hint_sun_5">O sol da manhã é o mais seguro e benéfico.</string>

    <!-- Dicas - Ar -->
    <string name="hint_air_1">O ar puro é vital para um cérebro saudável e pensamento claro.</string>
    <string name="hint_air_2">Respiração profunda ao ar livre oxigena o sangue.</string>
    <string name="hint_air_3">Ventile a sua casa regularmente para remover poluentes.</string>
    <string name="hint_air_4">Dormir com a janela aberta fornece ar fresco à noite.</string>
    <string name="hint_air_5">Plantas em casa ajudam a filtrar a qualidade do ar interior.</string>

    <!-- Dicas - Água -->
    <string name="hint_water_1">Beber água ajuda a manter a concentração e o foco.</string>
    <string name="hint_water_2">A água é essencial para a desintoxicação do corpo.</string>
    <string name="hint_water_3">Beba água antes de sentir sede para evitar a desidratação.</string>
    <string name="hint_water_4">A água ajuda a regular a temperatura do corpo.</string>
    <string name="hint_water_5">Substitua refrigerantes por água pura e fresca.</string>

