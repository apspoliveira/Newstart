<resources>
    <!-- Base application theme. Updated to Material 3 with explicit attribute definitions to prevent inflation crashes. -->
    <style name="Theme.Newstart" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/nutrition_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/workout_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/sun_primary</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Surface and Background colors -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/pro_max_card_bg</item>
        <item name="colorOnSurfaceVariant">@color/text_middle</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
