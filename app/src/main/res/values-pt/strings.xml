    <!-- Dicas - Temperança -->
    <string name="hint_temp_1">Temperança é o uso moderado do que é bom e a abstinência do que é mau.</string>
    <string name="hint_temp_2">Evite substâncias viciantes para manter a clareza mental.</string>
    <string name="hint_temp_3">O equilíbrio no trabalho e no descanso promove a longevidade.</string>
    <string name="hint_temp_4">Pratique o autocontrole em todas as áreas da sua vida.</string>
    <string name="hint_temp_5">Uma mente equilibrada toma melhores decisões para a saúde.</string>

    <!-- Dicas - Confiança -->
    <string name="hint_trust_1">A confiança em Deus traz paz interior e resiliência.</string>
    <string name="hint_trust_2">A gratidão diária melhora a saúde mental e emocional.</string>
    <string name="hint_trust_3">Meditar em promessas bíblicas reduz a ansiedade.</string>
    <string name="hint_trust_4">Um espírito alegre é um bom remédio para o corpo.</string>
    <string name="hint_trust_5">O descanso sabático restaura as energias físicas e espirituais.</string>

    <!-- Dicas - Descanso -->
    <string name="hint_rest_1">O sono de qualidade é essencial para a reparação celular e memória.</string>
    <string name="hint_rest_2">Procure dormir entre 7 a 8 horas por noite para uma saúde ideal.</string>
    <string name="hint_rest_3">Evite ecrãs pelo menos uma hora antes de dormir.</string>
    <string name="hint_rest_4">A regularidade no horário de dormir e acordar estabiliza o corpo.</string>
    <string name="hint_rest_5">Um quarto escuro e fresco promove um sono mais profundo.</string>

